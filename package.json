{
  "name": "sirius-ide",
  "version": "1.0.0",
  "description": "Sirius IDE — локальный AI-агент (Ollama / LM Studio / OpenAI-compatible)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "dev": "tsc && electron .",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:ci": "powershell -ExecutionPolicy Bypass -File scripts/test-pipeline.ps1",
    "test:cover": "powershell -ExecutionPolicy Bypass -File scripts/test-pipeline.ps1 -Cover",
    "rebuild:native": "node scripts/postinstall.js --rebuild-native",
    "dist": "npm run build && electron-builder --win nsis portable",
    "postinstall": "node scripts/postinstall.js"
  },
  "keywords": [
    "ide",
    "electron",
    "monaco",
    "ollama",
    "lm-studio"
  ],
  "author": "Sirius IDE",
  "license": "MIT",
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.10.0",
    "electron": "^41.0.3",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "typescript": "^5.3.0",
    "vitest": "^4.1.1"
  },
  "build": {
    "appId": "com.sirius.ide",
    "productName": "Sirius IDE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "package.json",
      "icon.ico",
      "node_modules/**/*",
      "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!node_modules/*.d.ts",
      "!node_modules/.bin",
      "!**/*.{map,ts}",
      "!**/node_modules/**/{electron,electron-builder,electron-rebuild,typescript,vitest,app-builder-*}/**"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/node-pty/**/*",
      "**/*.node"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "dompurify": "^3.3.3",
    "fs-extra": "^11.2.0",
    "monaco-editor": "^0.45.0",
    "node-pty": "^1.0.0",
    "prismjs": "^1.30.0",
    "simple-git": "^3.33.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  }
}
